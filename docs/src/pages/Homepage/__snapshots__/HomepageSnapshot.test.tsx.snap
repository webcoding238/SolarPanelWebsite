          style="margin: auto; padding: 3em; position: relative; display: flex; flex-direction: row; flex-wrap: nowrap; justify-content: center; background-color: white; color: black; width: 70%;"
        >
          <div
            class="recharts-wrapper"
            style="position: relative; cursor: default; width: 100%; max-width: 700px; max-height: 70vh; aspect-ratio: 1.618 / 1;"
            width="100%"
          />
        </div>
      </main>
    </div>
